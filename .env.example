# Database Configuration
DB_NAME=skillbridge_lms_db
DB_URL=jdbc:mysql://localhost:3306/skillbridge_lms_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT Security Configuration (Use a strong 256-bit secret string)
JWT_SECRET=replace_with_a_strong_32_plus_character_jwt_secret_key
JWT_EXPIRATION_MS=86400000

# Administrator Bootstrap Account & Sample Catalog Seeding
SEED_SAMPLE_COURSES=true
ADMIN_EMAIL=admin@skillbridge.edu
ADMIN_PASSWORD=replace_with_admin_password
ADMIN_NAME=SkillBridge Administrator

# External LLM API Configuration (Gemini or OpenAI-compatible)
LLM_API_KEY=your_gemini_or_openai_api_key_here
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
