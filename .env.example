# Database Configuration (Aiven MySQL in production / Local MySQL in development)
DB_NAME=defaultdb
DB_URL=jdbc:mysql://your-aiven-mysql-host:port/defaultdb?sslMode=REQUIRED&createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# JWT Security Configuration (Use a strong 256-bit secret string)
JWT_SECRET=replace_with_a_strong_32_plus_character_jwt_secret_key
JWT_EXPIRATION_MS=86400000

# Administrator Bootstrap Account & Sample Catalog Seeding
SEED_SAMPLE_COURSES=true
ADMIN_EMAIL=admin@skillbridge.edu
ADMIN_PASSWORD=replace_with_admin_password
ADMIN_NAME=SkillBridge Administrator

# External LLM API Configuration (Gemini or OpenAI-compatible)
LLM_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# Frontend & CORS Configuration
VITE_API_BASE_URL=https://skillbridge-backend-api.onrender.com/api
CORS_ALLOWED_ORIGINS=https://*.onrender.com,http://localhost:5173,http://localhost:3000
